{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliverableManifest",
  "description": "Manifest of assets for a published deliverable. Generated by backend Stage 8 and consumed by the viewer + PDF renderer.",
  "type": "object",
  "required": [
    "deliverable_id",
    "test_id",
    "assets",
    "base_path",
    "created_at"
  ],
  "properties": {
    "deliverable_id": {
      "type": "string",
      "pattern": "^deliv_[A-Za-z0-9]{10,}$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^test_[A-Za-z0-9]{10,}$"
    },
    "client_display_name": { "type": ["string", "null"] },
    "test_display_title": { "type": ["string", "null"] },
    "test_display_subtitle": { "type": ["string", "null"] },

    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "kind", "title", "html_path", "order"],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^asset_[A-Za-z0-9]{6,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "executive_report",
              "audience",
              "individual_report",
              "interviews",
              "forecast",
              "appendix_metrics",
              "appendix_methodology"
            ]
          },
          "title": { "type": "string" },
          "html_path": { "type": "string" },
          "pdf_path": { "type": ["string", "null"] },
          "order": {
            "type": "integer",
            "minimum": 0,
            "description": "Sidebar order. 1-9 main, 10-19 variants, 20-29 optional sections, 30-39 voices (interviews), 40-49 raw data, 50-59 methodology."
          }
        }
      }
    },

    "base_path": {
      "type": "string",
      "description": "Absolute path or URL where the assets live (filesystem or blob storage key prefix)."
    },

    "access_token": {
      "type": ["string", "null"],
      "description": "JWT embedded in the signed URL. Null means public (should never be null in production)."
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 expiration. Null = no expiration (only for internal audits, never for client delivery)."
    },

    "branding": {
      "type": ["object", "null"],
      "properties": {
        "logo_url": { "type": ["string", "null"] },
        "primary_color": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$"
        }
      }
    },

    "views": {
      "type": "integer",
      "minimum": 0
    },
    "view_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "ip": { "type": "string" },
          "ua": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },

    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
