# Sharpz V2 backend — environment template
# Copy to .env.local (gitignored) and fill in values

# ========== Core ==========
ENV=development                          # development | staging | production
LOG_LEVEL=INFO

# ========== Database ==========
POSTGRES_USER=sharpz
POSTGRES_PASSWORD=sharpz_dev
POSTGRES_DB=sharpz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sharpz:sharpz_dev@localhost:5432/sharpz

# ========== Redis (job queue + cache) ==========
REDIS_URL=redis://localhost:6379/0

# ========== LLM provider (OpenRouter — single provider) ==========
OPENROUTER_API_KEY=                      # fill with your OpenRouter key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=sharpz-analytics
OPENROUTER_HTTP_REFERER=https://sharpzanalytics.com

# ========== Storage (R2 for stimulus + deliverables) ==========
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_STIMULUS=sharpz-stimulus
R2_BUCKET_DELIVERABLES=sharpz-deliverables

# ========== Auth secrets ==========
SHARPZ_SYNC_KEY=                         # shared secret for operator endpoints
JWT_SECRET=                              # for signed deliverable URLs
JWT_ALGORITHM=HS256
JWT_DELIVERABLE_EXPIRY_DAYS=90

# ========== Email (Resend) ==========
RESEND_API_KEY=
EMAIL_FROM=noreply@sharpzanalytics.com

# ========== Feature flags ==========
ENABLE_LOCAL_NER=false                   # requires local-inference extras + GPU
ENABLE_LOCAL_EMBEDDINGS=false
ENABLE_MULTI_SEED_AGGREGATION=true

# ========== Cost guardrails ==========
TIER_ECONOMY_COST_CAP_USD=25
TIER_PRO_COST_CAP_USD=60
TIER_PREMIUM_COST_CAP_USD=120
TIER_ULTRA_COST_CAP_USD=300

# ========== Ops ==========
CORS_ALLOWED_ORIGINS=https://sharpzanalytics.com,http://localhost:5173
OPERATOR_NOTIFICATION_EMAIL=julian@sharpzanalytics.com
